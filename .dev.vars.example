# Copy to .dev.vars (gitignored) for `wrangler pages dev`.
# Format: KEY="value"  (wrangler parses this like dotenv)

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
JWT_SECRET="change-me-to-a-long-random-string"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8788/api/google/callback"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Resend (https://resend.com) — usado para o email de redefinir senha.
# Sem isso o /auth/forgot ainda responde "ok" mas nenhum email é enviado.
RESEND_API_KEY=""
FROM_EMAIL="Portal SENAI <onboarding@resend.dev>"

