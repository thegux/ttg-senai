{
  "name": "portal-senai",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm --workspace api run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspaces run build --if-present",
    "db:setup": "npm --workspace api run db:setup"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
