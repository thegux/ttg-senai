{
  "name": "portal-senai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "functions"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:functions",
    "dev:web": "npm --workspace web run dev",
    "dev:functions": "wrangler pages dev apps/web/dist --port 8788 --live-reload",
    "build": "npm --workspace web run build",
    "preview": "npm run build && wrangler pages dev apps/web/dist --port 8788",
    "deploy": "npm run build && wrangler pages deploy apps/web/dist",
    "db:setup": "psql \"$DATABASE_URL\" -f db/schema.sql"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "wrangler": "^3.80.0"
  }
}
